{
  "name": "tools-qrcode",
  "version": "1.0.0",
  "description": "Gerador e leitor de QR Code — processamento local, offline, sem dependências externas em runtime.",
  "private": true,
  "type": "module",
  "author": "Gustavo Viana",
  "license": "MIT",
  "homepage": "https://qr.tools.grviana.com.br/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gustavorviana/tools-qrcode.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "node build.mjs && npx --yes serve -l 5000 dist",
    "preview:online": "node tunnel.mjs"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "qr-code-styling": "^1.9.2",
    "zxing-wasm": "^3.1.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
